# harness-api talks to a local Anvil fork. Nothing here is a secret and no account
# with any provider is required. Every value below is also the built-in default, so
# an empty .env (or no .env at all) works exactly the same.

PORT=8787
WEB_ORIGIN=http://localhost:3000

# The fork. Start one with `npm run fork` for the exact command.
RPC_URL=http://127.0.0.1:8545
CHAIN_ID=1
FORK_BLOCK=25710954

# Anvil's first dev account. Published in Anvil's own docs, holds only play money on a
# local fork. Replace it if you point RPC_URL at anything else.
DEPLOYER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Only if you run an explorer against the fork (Otterscan, say). Empty means deploy and
# simulate report no link, which is the honest answer for a local chain.
EXPLORER_BASE=
