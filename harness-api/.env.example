# ---- HTTP ----
PORT=8787
# Comma-separated allowlist of browser origins permitted to call this API (Agent A's web app).
WEB_ORIGIN=http://localhost:3000

# ---- Tenderly Virtual Environment (created once, ahead of time, by `npm run vnet:create`) ----
# Admin RPC: has tenderly_* cheatcodes. NEVER expose this to the browser.
TENDERLY_ADMIN_RPC=
# Public RPC: safe to share, used for the read-only explorer story.
TENDERLY_PUBLIC_RPC=
# Public explorer base, e.g. https://dashboard.tenderly.co/explorer/vnet/<vnet-id>
TENDERLY_EXPLORER_BASE=
# Chain id of the virtual network (chain_config_overrides.chain_id). 1 = mainnet passthrough.
TENDERLY_CHAIN_ID=1

# ---- Tenderly REST (only needed by src/scripts/create-vnet.ts) ----
TENDERLY_ACCOUNT=
TENDERLY_PROJECT=
TENDERLY_ACCESS_KEY=
# Optional pin. Leave blank to fork at latest.
TENDERLY_FORK_BLOCK=

# ---- Deployer ----
# Throwaway key for the virtual net ONLY. Never a key that holds real funds.
DEPLOYER_PRIVATE_KEY=
